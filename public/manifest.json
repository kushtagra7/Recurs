{
    "manifest_version": 3,
    "name": "Recurs",
    "version": "0.1.0",
    "description": "Your DSA revision assistant.",

    "permissions":[
        "activeTab",
        "storage"
    ],

    "action": {
        "default_popup": "index.html"
    },

    "content_scripts": [
        {
            "matches":["https://leetcode.com/problems/*"],
            "js":["content.js"]
        }
    ]
}